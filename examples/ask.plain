# Plain v0.2 — Interactive input demo: cargo run -- examples/ask.plain

ask name with "What is your name?"
say "Nice to meet you, " + name

ask age with "How old are you?"

if age is between 13 and 19
    say "You are a teenager!"
otherwise if age is at least 20
    say "You are an adult!"
otherwise
    say "You are a kid!"
end

ask favorite_food with "What is your favorite food?"
say "Awesome, " + uppercase of favorite_food + " is delicious!"
